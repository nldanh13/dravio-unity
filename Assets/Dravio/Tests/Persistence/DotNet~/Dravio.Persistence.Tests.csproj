<!--
  Chạy test U2.2 (persistence + platform) ngoài Unity bằng .NET SDK (Unity bỏ qua thư mục kết thúc bằng "~").
  Biên dịch đúng các file .cs mà Unity biên dịch cho Dravio.Domain, Dravio.Persistence, Dravio.Platform
  (không gồm Platform/Unity, vốn cần UnityEngine), với LangVersion 9.
    dotnet test Assets/Dravio/Tests/Persistence/DotNet~/Dravio.Persistence.Tests.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Domain/**/*.cs" />
    <Compile Include="../../../Persistence/**/*.cs" />
    <Compile Include="../../../Platform/*.cs" />
    <Compile Include="../*.cs;../Support/*.cs" />
    <!-- U2.12: trạng thái cuối hành trình ba thế giới lấy từ bộ mô phỏng của Domain.Tests (Unity: tham chiếu assembly Dravio.Domain.Tests). -->
    <Compile Include="../../Domain/Simulation/EconomySimulator.cs" />
    <Compile Include="../../Domain/Simulation/AlphaJourney.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
