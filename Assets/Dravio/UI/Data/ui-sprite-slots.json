{
  "version": "vis2a-1",
  "note": "VIS.2a sprite slot contract (Issue #86). Paths and IDs are proposals for AI3; borders are provisional and MUST be measured on the approved sprite, then set in the Sprite Editor (the importer copies borderPx only when the sprite has none). Text is never baked into art. Source PNGs stay in ArtSource; only approved runtime copies go under Assets/Dravio/UI/Sprites.",
  "referenceResolution": [
    1280,
    720
  ],
  "compactReferenceResolution": [
    960,
    540
  ],
  "importProfile": {
    "format": "PNG RGBA 8-bit, straight alpha, sRGB",
    "mipmaps": false,
    "wrap": "Clamp",
    "filter": "Bilinear",
    "alphaIsTransparency": true,
    "npotScale": "None",
    "spriteMode": "Single",
    "meshType": "FullRect",
    "pixelsPerUnit": 100,
    "standalone": "RGBA32 (uncompressed) for review",
    "android": "ASTC 4x4 (clean UI edges), fallback RGBA32",
    "ios": "ASTC 4x4",
    "atlasPadding": "4 px without mips / 8 px with mips or block compression",
    "maxSize": "per slot: smallest size that does not upscale at canvas scale 2.67 (compact 540 reference on a 1440 px tall phone); see Docs/vis2a"
  },
